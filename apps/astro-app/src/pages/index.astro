---
import MainLayout from "../layouts/main.astro"
import { createSupabaseServerClient } from "@/kernel/db/supabase-server"
import SiteHeader from "@/modules/marketing/presentation/site-header.astro"
import Hero from "@/modules/marketing/presentation/hero.astro"
import Features from "@/modules/marketing/presentation/features.astro"
import HowItWorks from "@/modules/marketing/presentation/how-it-works.astro"
import DataOwnership from "@/modules/marketing/presentation/data-ownership.astro"
import ClosingCta from "@/modules/marketing/presentation/closing-cta.astro"
import SiteFooter from "@/modules/marketing/presentation/site-footer.astro"

/**
 * The homepage is public for everyone, signed in or not.
 *
 * It used to bounce an authenticated visitor straight to `/app`, which made
 * the product's own front page unreachable to the people who use it. The
 * session is still read — the header swaps its two auth links for one way
 * into the app — but nobody gets redirected away from a page they asked for.
 */
const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
})

const {
  data: { user },
} = await supabase.auth.getUser()
---

<MainLayout
  title="A clean record of what you paid"
  description="Log an expense in seconds, import CSV or Excel statements, and find any of it later. Categories, recurring payments, history and simple summaries — no budgets, no forecasts."
>
  <a
    href="#main"
    class="sr-only rounded-md bg-card px-4 py-2 text-sm font-medium text-foreground ring-1 ring-foreground/10 focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-40"
  >
    Skip to content
  </a>

  <SiteHeader isAuthenticated={Boolean(user)} />

  <main id="main">
    <Hero />
    <Features />
    <HowItWorks />
    <DataOwnership />
    <ClosingCta />
  </main>

  <SiteFooter />
</MainLayout>
