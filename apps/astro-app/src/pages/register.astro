---
import { createSupabaseServerClient } from "@/shared/data-sources/supabase-server"
import MainLayout from "@/core/layouts/main.astro"
import { RegisterShell } from "@/core/modules/register"
import { AppRouter } from "@/shared/routing/app-router"

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
})

const {
  data: { user },
} = await supabase.auth.getUser()

if (user) {
  return Astro.redirect(AppRouter.getPath("dashboard"))
}
---

<MainLayout title="Register">
  <RegisterShell client:load />
</MainLayout>
