---
import { AppRouter } from "@/shared/routing/app-router"
import Logo from "./logo.astro"

const year = new Date().getFullYear()

/**
 * Two named groups rather than five links in a row.
 *
 * The flat row worked but said nothing about what any link was for, and it was
 * the only place a phone visitor could find "Sign in" — which is the header's
 * job, fixed there. Grouping costs one line of markup and makes the footer
 * navigable instead of merely present.
 */
const groups = [
  {
    name: "The product",
    links: [
      { href: "#features", label: "Features" },
      { href: "#how", label: "How it works" },
      { href: "#data", label: "Your data" },
    ],
  },
  {
    name: "Your account",
    links: [
      { href: AppRouter.getPath("login"), label: "Sign in" },
      { href: AppRouter.getPath("register"), label: "Create account" },
    ],
  },
]
---

<footer class="border-t border-border">
  <div
    class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-12 sm:px-6 sm:py-14 lg:grid-cols-12 lg:px-8"
  >
    <div class="lg:col-span-5">
      <Logo />
      <p class="mt-3 max-w-[34ch] text-sm text-muted-foreground">
        A record of what you paid, and nothing heavier bolted on.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-8 lg:col-span-6 lg:col-start-7">
      {
        groups.map((group) => (
          <nav aria-label={group.name}>
            <p class="text-sm font-medium text-foreground">{group.name}</p>
            <ul class="mt-3 space-y-2.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="rounded-sm text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="border-t border-border">
    <p
      class="mx-auto w-full max-w-6xl px-4 py-5 font-mono text-xs text-muted-foreground sm:px-6 lg:px-8"
    >
      © {year} ExpenseHub
    </p>
  </div>
</footer>
