---
import { buttonVariants } from "@/libs/ui/button"
import { AppRouter } from "@/kernel/routing/app-router"
import Logo from "./logo.astro"

/**
 * Solid, not frosted. A blurred translucent bar is the default reflex for a
 * sticky header and it puts moving content behind every link on the page;
 * the surface here is the page's own colour, so the header simply stops
 * existing as a visual event and the content scrolls under it.
 */
interface Props {
  /** Signed-in visitors get a way into the app instead of two auth links. */
  isAuthenticated?: boolean
}

const { isAuthenticated = false } = Astro.props

const links = [
  { href: "#features", label: "Features" },
  { href: "#how", label: "How it works" },
  { href: "#data", label: "Your data" },
]
---

<header
  class="sticky top-0 z-30 border-b border-border bg-background/98 supports-[backdrop-filter]:backdrop-blur-[2px]"
>
  <div
    class="mx-auto flex h-16 w-full max-w-6xl items-center gap-4 px-4 sm:px-6 lg:px-8"
  >
    <a
      href={AppRouter.getPath("home")}
      class="rounded-md outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
      aria-label="ExpenseHub home"
    >
      <Logo />
    </a>

    <nav aria-label="Sections" class="ml-4 hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      {
        isAuthenticated ? (
          <a href={AppRouter.getPath("dashboard")} class={buttonVariants()}>
            Open ExpenseHub
          </a>
        ) : (
          <>
            {/* A link, not a second button. Two filled controls in a header
                make the page ask twice and read as a template. */}
            <a
              href={AppRouter.getPath("login")}
              class="inline-flex rounded-sm text-sm font-medium text-foreground underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
            >
              Sign in
            </a>
            <a href={AppRouter.getPath("register")} class={buttonVariants()}>
              Create account
            </a>
          </>
        )
      }
    </div>
  </div>
</header>
